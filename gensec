#!/bin/bash
# gensec — gera secrets criptograficamente seguros e copia pro clipboard.
# Uso: gensec [tipo] [tamanho]
# Tipos: hex (padrão), b64, uuid, alnum, pass — veja `gensec --help`.
set -euo pipefail

# Cores só quando a saída é um terminal
if [[ -t 1 ]]; then
  B=$'\033[1m'; C=$'\033[36m'; G=$'\033[32m'; D=$'\033[2m'; R=$'\033[0m'
else
  B=''; C=''; G=''; D=''; R=''
fi

ajuda() {
  cat <<EOF

  ${B}🔐 gensec${R} ${D}—${R} gerador de secrets criptograficamente seguros

  ${B}USO${R}
    gensec ${C}[tipo]${R} ${C}[tamanho]${R}

  ${B}TIPOS${R}
    ${C}hex${R}    bytes aleatórios em hexadecimal     ${D}(padrão · 32 bytes)${R}
    ${C}b64${R}    bytes aleatórios em base64          ${D}(bom pra JWT secret)${R}
    ${C}uuid${R}   UUID v4 em minúsculas               ${D}(ignora tamanho)${R}
    ${C}alnum${R}  só letras e números [A-Za-z0-9]     ${D}(seguro pra URL/env/header)${R}
    ${C}pass${R}   passphrase de palavras com dígitos   ${D}(padrão · 8 palavras)${R}
    ${C}ssh${R}    passphrase forte pra chave SSH      ${D}(seguro pra shell · 40 caracteres)${R}

  ${B}EXEMPLOS${R}
    ${G}gensec hex${R}       ${D}# 32 bytes em hex${R}
    ${G}gensec b64 48${R}    ${D}# JWT secret com 48 bytes em base64${R}
    ${G}gensec uuid${R}      ${D}# UUID v4${R}
    ${G}gensec pass${R}      ${D}# passphrase forte de 8 palavras com dígitos${R}
    ${G}gensec pass 12${R}   ${D}# passphrase ainda mais forte, com 12 palavras${R}
    ${G}gensec ssh${R}       ${D}# passphrase de 40 caracteres pra chave SSH${R}

  ${D}desenvolvido por Bernardo Rodrigues · github.com/berodcdev${R}

EOF
}

# Sem nenhum argumento: mostra o menu. Pra gerar, passe um tipo na frente.
if [[ $# -eq 0 ]]; then
  ajuda
  exit 0
fi

TIPO="$1"
TAMANHO="${2:-}"

if [[ "$TIPO" == "-h" || "$TIPO" == "--help" ]]; then
  ajuda
  exit 0
fi

# Sem tamanho explícito, cada tipo tem seu padrão.
# pass conta palavras (não caracteres); ssh prefere passphrase longa.
if [[ -z "$TAMANHO" ]]; then
  case "$TIPO" in
    pass) TAMANHO=8 ;;
    ssh)  TAMANHO=40 ;;
    *)    TAMANHO=32 ;;
  esac
fi

if ! [[ "$TAMANHO" =~ ^[0-9]+$ ]] || [[ "$TAMANHO" -eq 0 ]]; then
  echo "Erro: tamanho inválido: '$TAMANHO' (use um número inteiro maior que zero)" >&2
  exit 1
fi

# Extrai $TAMANHO caracteres do charset dado, lendo de /dev/urandom.
# Lê um bloco grande de uma vez pra evitar SIGPIPE com pipefail.
de_urandom() {
  local charset="$1" saida
  saida="$(head -c $((TAMANHO * 64)) /dev/urandom | LC_ALL=C tr -dc "$charset")"
  printf '%s' "${saida:0:TAMANHO}"
}

# Inteiro aleatório uniforme em [0, max) via openssl, com rejeição do excesso
# pra não ter viés de módulo. Usado pela passphrase de palavras (tipo pass).
rand_int() {
  local max="$1" limit val
  limit=$(( (4294967296 / max) * max ))   # maior múltiplo de max que cabe em 32 bits
  while :; do
    val=$(( 16#$(openssl rand -hex 4) ))
    if (( val < limit )); then break; fi
  done
  printf '%s' $(( val % max ))
}

