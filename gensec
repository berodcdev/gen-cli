# Recebe o secret no stdin e copia pro clipboard do sistema.
# Tenta, em ordem: macOS (pbcopy), Wayland (wl-copy), X11 (xclip/xsel).
# Retorna 1 se nenhum utilitário estiver disponível.
copiar_clipboard() {
  if command -v pbcopy >/dev/null 2>&1; then
    pbcopy
  elif command -v wl-copy >/dev/null 2>&1; then
    wl-copy
  elif command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard
  elif command -v xsel >/dev/null 2>&1; then
    xsel --clipboard --input
  else
    return 1
  fi
}

# Imprime o comando de "colar" equivalente ao clipboard disponível,
# pra montar a dica do ssh. Vazio se não houver utilitário.
comando_colar() {
  if command -v pbpaste >/dev/null 2>&1; then
    printf 'pbpaste'
  elif command -v wl-paste >/dev/null 2>&1; then
    printf 'wl-paste'
  elif command -v xclip >/dev/null 2>&1; then
    printf 'xclip -selection clipboard -o'
  elif command -v xsel >/dev/null 2>&1; then
    printf 'xsel --clipboard --output'
  fi
}

case "$TIPO" in
  hex)
    SECRET="$(openssl rand -hex "$TAMANHO")"
    ;;
  b64)
    SECRET="$(openssl rand -base64 "$TAMANHO" | tr -d '\n')"
    ;;
  uuid)
    SECRET="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    ;;
  alnum)
    SECRET="$(de_urandom 'A-Za-z0-9')"
    ;;
  pass)
    # passphrase estilo Opposite-Day-My4-Package-Gently2: $TAMANHO palavras
    # sorteadas, cada uma em Title-Case, unidas por hífen. Um dígito aleatório
    # é anexado a ~1/3 das palavras (mínimo 1), em posições distintas sorteadas.
    read -r -d '' -a PALAVRAS <<< "$LISTA_PALAVRAS" || true
    TOTAL=${#PALAVRAS[@]}
    N_DIGITOS=$(( (TAMANHO + 2) / 3 ))   # ~1/3 das palavras recebem dígito (mín. 1)
    # marca N_DIGITOS posições distintas que vão ganhar um dígito no fim
    TEM_DIGITO=()
    for (( i = 0; i < TAMANHO; i++ )); do TEM_DIGITO[i]=0; done
    marcadas=0
    while (( marcadas < N_DIGITOS )); do
      p=$(rand_int "$TAMANHO")
      if (( TEM_DIGITO[p] == 0 )); then
        TEM_DIGITO[p]=1
        marcadas=$(( marcadas + 1 ))
      fi
    done
    PARTES=()
    for (( i = 0; i < TAMANHO; i++ )); do
      W="${PALAVRAS[$(rand_int "$TOTAL")]}"
      INICIAL="$(printf '%s' "${W:0:1}" | LC_ALL=C tr '[:lower:]' '[:upper:]')"
      W="${INICIAL}${W:1}"
      if (( TEM_DIGITO[i] == 1 )); then W="${W}$(rand_int 10)"; fi
      PARTES+=("$W")
    done
    SECRET="$(IFS=-; printf '%s' "${PARTES[*]}")"
    ;;
  ssh)
    # Mesmo charset de pass: sem aspas/barra, seguro pra colar em ssh-keygen -N '...'
    SECRET="$(de_urandom 'A-Za-z0-9!@#$%^&*()_+=-')"
    ;;
  *)
    echo "Erro: tipo inválido: '$TIPO'" >&2
    ajuda >&2
    exit 1
    ;;
esac

# printf '%s' sem newline: evita copiar um '\n' junto com o secret
if printf '%s' "$SECRET" | copiar_clipboard 2>/dev/null; then
  COPIADO=1
else
  COPIADO=0
fi

printf '%s\n' "$SECRET"

# pass conta palavras; os demais tipos contam caracteres.
if [[ "$TIPO" == "pass" ]]; then
  MEDIDA="${TAMANHO} palavras"
else
  MEDIDA="${#SECRET} caracteres"
fi

if [[ "$COPIADO" -eq 1 ]]; then
  echo "${G}✓${R} ${TIPO} · ${MEDIDA} ${D}· copiado pro clipboard${R}" >&2
else
  echo "${G}✓${R} ${TIPO} · ${MEDIDA}" >&2
  echo "  ${D}⚠ nenhum utilitário de clipboard encontrado — instale xclip, xsel ou wl-clipboard pra copiar automático${R}" >&2
fi

if [[ "$TIPO" == "ssh" ]]; then
  PASTE="$(comando_colar)"
  if [[ -n "$PASTE" ]]; then
    echo "  ${D}dica: ssh-keygen -t ed25519 -N \"\$(${PASTE})\" -f ~/.ssh/minha-chave${R}" >&2
  fi
fi
